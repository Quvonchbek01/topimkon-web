# Nusxa oling: cp .env.example .env.local  — va qiymatlarni to‘ldiring.
# .env.local hech qachon GitHub'ga yuklanmaydi (.gitignore'da bor).

# --- Sayt manzili (lokalda shunday qoladi; deployda o‘z domeningiz) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # brauzerga chiqishi mumkin (RLS himoya qiladi)
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # FAQAT server! "NEXT_PUBLIC_" bilan boshlanmaydi

# --- Telegram (4-bosqichda ishlatiladi) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Resend email (4-bosqichda ishlatiladi) ---
RESEND_API_KEY=
EMAIL_FROM="TopImkon <eslatma@sizning-domen.uz>"

# --- Vercel Cron himoyasi (4-bosqichda ishlatiladi) ---
CRON_SECRET=

# --- 4-bosqich qo‘shimchalari ---
TELEGRAM_BOT_USERNAME=                          # @ belgisiz, masalan: TopImkonBot
REMINDER_SECRET=                                # email'dagi "bekor qilish" havolasini imzolash uchun (uzun tasodifiy qator)
# TELEGRAM_WEBHOOK_SECRET va CRON_SECRET ham tasodifiy uzun qator bo‘lsin (A-Z, a-z, 0-9, _ - belgilari)
